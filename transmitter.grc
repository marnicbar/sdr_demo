- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: "def set_window_mode(fullscreen):\n    if fullscreen:\n        self.showFullScreen()\n\
      \    else:\n        self.showNormal()\n\n# Attach function to the instance\n\
      # self.set_window_mode = set_window_mode\n\nself._fullscreen_select_button_group.buttonClicked[int].connect(\n\
      \    lambda i: set_window_mode(self._fullscreen_select_options[i])\n)"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1320, 12.0]
    rotation: 0
    state: enabled
- name: snippet_2
  id: snippet
  parameters:
    alias: ''
    code: "from PyQt5 import QtCore\nQtCore.QTimer.singleShot(\n    0,\n    lambda:\
      \ (\n        self.set_fullscreen_select(self.isFullScreen()),\n        print(\"\
      Fullscreen radio button initialized\")\n    )\n)"
    comment: ''
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 12.0]
    rotation: 0
    state: enabled

