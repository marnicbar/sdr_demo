- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Embedded Python Block\
      \ example - a simple multiply const\"\"\"\n\n    def __init__(self, n_bits =\
      \ 8):\n        \"\"\"arguments to this function show up as parameters in GRC\"\
      \"\"\n        gr.sync_block.__init__(\n            self,\n            name='Byte\
      \ To Shorts',\n            in_sig=[np.uint8],\n            out_sig=[np.int16]\n\
      \        )\n        if (n_bits < 1 or n_bits > 8):\n            raise ValueError(f\"\
      n_bits must be in range 1..8 (was {n_bits})\")\n        self.n_bits = n_bits\n\
      \n    def work(self, input_items, output_items):\n        output_items[0][:]\
      \ = (input_items[0].astype(np.uint16) << (16 - self.n_bits)).astype(np.int16)\n\
      \        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    n_bits: quantization
  states:
    _io_cache: ('Byte To Shorts', 'blk', [('n_bits', '8')], [('0', 'byte', 1)], [('0',
      'short', 1)], 'Embedded Python Block example - a simple multiply const', ['n_bits'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 500.0]
    rotation: 0
    state: enabled
