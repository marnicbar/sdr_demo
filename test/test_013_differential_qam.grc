      \"\"\n        gr.sync_block.__init__(\n            self,\n            name='Short\
      \ To Byte',\n            in_sig=[np.int16],\n            out_sig=[np.uint8]\n\
      \        )\n        if (n_bits < 1 or n_bits > 8):\n            raise ValueError(f\"\
