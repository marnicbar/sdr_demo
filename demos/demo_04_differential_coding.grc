    label1: '4'
    label2: '6'
    label3: '8'
    label4: ''
    labels: '[]'
    num_opts: '4'
    option0: '2'
    option1: '4'
    option2: '6'
    option3: '8'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
